# Bu dosyayı .env olarak kopyala ve değerleri doldur
# Yerelde başlangıç için SQLite yeterli; Supabase/Neon'a geçince PostgreSQL adresini yaz
DATABASE_URL=sqlite:///./fon.db
# DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani
FRONTEND_URL=http://localhost:5173

# Günlük TEFAS güncellemesi (hafta içi, İstanbul saati)
SCHEDULER_ENABLED=true
UPDATE_HOUR=21
UPDATE_MINUTE=0
CATCH_UP_ON_STARTUP=true

# Sharpe oranı için yıllık risksiz getiri (ör. 0.40 = %40).
# Boş bırakılırsa para piyasası fonlarının 1 yıllık medyan getirisi kullanılır.
# RISK_FREE_RATE=0.40
